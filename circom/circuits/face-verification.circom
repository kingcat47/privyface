pragma circom 2.0.0;`n`ninclude "node_modules/circomlib/circuits/poseidon.circom";`ninclude "node_modules/circomlib/circuits/comparators.circom";`n`ntemplate FaceVerification(n_features, levels) {`n    signal input governmentFeatures[n_features];`n    signal input userFeatures[n_features];`n    signal input pathElements[levels];`n    signal input pathIndices[levels];`n    signal input root;`n    signal input threshold;`n`n    signal diff[n_features];`n    signal square[n_features];`n    var dist_sum = 0;`n`n    for (var i = 0; i < n_features; i++) {`n        diff[i] <== userFeatures[i] - governmentFeatures[i];`n        square[i] <== diff[i] * diff[i];`n        dist_sum += square[i];`n    }`n`n    component lt = LessThan(252);`n    lt.in[0] <== dist_sum;`n    lt.in[1] <== threshold;`n    lt.out === 1;`n`n    component leafHasher = Poseidon(n_features);`n    for (var i = 0; i < n_features; i++) {`n        leafHasher.inputs[i] <== userFeatures[i];`n    }`n    `n    signal leaf <== leafHasher.out;`n`n    component hashers[levels];`n    signal currentHash[levels + 1];`n    currentHash[0] <== leaf;`n`n    for (var i = 0; i < levels; i++) {`n        hashers[i] = Poseidon(2);`n        `n        signal left;`n        signal right;`n        `n        signal temp1;`n        signal temp2;`n        temp1 <== (1 - pathIndices[i]) * currentHash[i];`n        temp2 <== pathIndices[i] * pathElements[i];`n        left <== temp1 + temp2;`n        `n        signal temp3;`n        signal temp4;`n        temp3 <== pathIndices[i] * currentHash[i];`n        temp4 <== (1 - pathIndices[i]) * pathElements[i];`n        right <== temp3 + temp4;`n        `n        hashers[i].inputs[0] <== left;`n        hashers[i].inputs[1] <== right;`n        `n        currentHash[i+1] <== hashers[i].out;`n    }`n`n    currentHash[levels] === root;`n}`n`ncomponent main { public [root, threshold] } = FaceVerification(10, 2);